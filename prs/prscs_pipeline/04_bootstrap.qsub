#!/bin/bash
#$ -N boot
#$ -cwd
#$ -j y
#$ -o log/
#$ -l h_vmem=32g
#$ -l h_rt=12:00:00
#$ -t 1-11
# PHASED per-trait bootstrap so partial results survive walltime. Order (fast -> slow):
#   1) EUR on a 10k random subset  -> incR2_<thr>_eur10k.tsv, and COPIED to the main EUR file
#      (so the main EUR result is never empty; it's the 10k fallback until full EUR finishes)
#   2) AFR, EAS, CSA (full, small) -> their incR2_<thr>.tsv
#   3) FULL EUR (~400k, slow)      -> OVERWRITES the main EUR incR2_<thr>.tsv if it completes
# If walltime kills phase 3, you still have (1)+(2): all 4 ancestries + the FELIX comparison,
# EUR just at N=10k (wider CI). B stays 2000.
#   qsub 04_bootstrap.qsub                       # 5e-8
#   qsub -v CLUMP_P1=5e-6 04_bootstrap.qsub      # 5e-6
#   qsub -v B=1000 04_bootstrap.qsub             # faster full-EUR tail (looser CIs)
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/config.sh"
HERE="${SCRIPTS_DIR}"

# 10k EUR validation subset, disjoint from the eur10k LD panel (deterministic + atomic)
KV="${BASE}/keeps/eur10kval.keep"
seeded(){ openssl enc -aes-256-ctr -pass pass:"$1" -nosalt </dev/zero 2>/dev/null; }
[ -s "${KV}" ] || { comm -23 <(sort "${BASE}/keeps/EUR.keep") <(sort "${BASE}/keeps/eur10k.keep") \
   | shuf --random-source=<(seeded 45) -n 10000 > "${KV}.$$" && mv "${KV}.$$" "${KV}"; }

TRAIT=$(echo ${TRAITS} | cut -d' ' -f"${SGE_TASK_ID:-1}")
: "${TRAIT:?bad SGE_TASK_ID ${SGE_TASK_ID:-} (expected 1..11)}"
T="${CLUMP_P1}"; D="${BASE}/results/${TRAIT}/EUR"

echo ">>> PHASE 1: EUR 10k subset (${TRAIT})"
ONLY_VAL=EUR EUR_KEEP="${KV}" OUTSUF=_eur10k bash "${HERE}/run_bootstrap.sh" "${TRAIT}"
# seed the main EUR file with the 10k result so it's never empty
[ -s "${D}/incR2_${T}_eur10k.tsv" ]      && cp "${D}/incR2_${T}_eur10k.tsv"      "${D}/incR2_${T}.tsv"
[ -s "${D}/incR2_${T}_eur10k_diff.tsv" ] && cp "${D}/incR2_${T}_eur10k_diff.tsv" "${D}/incR2_${T}_diff.tsv"

echo ">>> PHASE 2: AFR EAS CSA (${TRAIT})"
ONLY_VAL="AFR EAS CSA" bash "${HERE}/run_bootstrap.sh" "${TRAIT}"

echo ">>> PHASE 3: full EUR (${TRAIT}) -- may hit walltime; phases 1-2 already saved"
ONLY_VAL=EUR bash "${HERE}/run_bootstrap.sh" "${TRAIT}"
echo ">>> phased bootstrap complete for ${TRAIT}"
